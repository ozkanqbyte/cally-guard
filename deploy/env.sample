# Copy to .env before `docker compose up`.

# ── LiveKit (generate: docker run --rm livekit/livekit-server generate-keys) ──
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-to-a-long-random-string

# ── Firebase Admin (push live risk to the user's phone via FCM) ──
# Path inside the worker container to a service-account json.
FCM_SERVICE_ACCOUNT_JSON=/run/secrets/fcm.json

# ── Speech-to-text ──────────────────────────────────────────────
# whisper = free, self-hosted (docker compose brings it up)   [default]
# deepgram = Nova-3, best Turkish, ~$0.02–0.05 / 5-min call
STT_PROVIDER=whisper
DEEPGRAM_API_KEY=

# ── Text-to-speech ──────────────────────────────────────────────
# piper      = free, self-hosted, robotic-but-fine for a "distracted person"  [default]
# elevenlabs = most natural Turkish, ~$0.05–0.20 / call  (free tier ~10 min/mo, test only)
# cartesia   = cheap low-latency real-time
TTS_PROVIDER=piper
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL: eleven_turbo_v2_5 (default, ~450ms, best balance) |
#                   eleven_flash_v2_5 (~310ms, fastest) |
#                   eleven_v3_conversational (~1.1s, most human — bot is unhurried so OK)
ELEVENLABS_MODEL=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# ── Human pacing: ms the AI "thinks" before each line (0 = instant/robotic) ──
AGENT_PACE_MS=350

# ── Evidence recording (optional). Blank = OFF. ─────────────────────────────
# When set, the AI Guard keeps a short WAV of a call it FLAGGED as a scam
# (caller side only). Point this at a mounted bucket and add a lifecycle rule
# that deletes clips after ~15 days. Get a lawyer to sign off the consent line
# before turning this on in production (KVKK / GDPR).
GUARD_RECORD_DIR=
GUARD_RECORD_MAX_SECONDS=240

# ── Detection locale for the voice server (scam lexicon). tr | en | … ──
GUARD_LOCALE=tr
# guard_reports -> learning queue job (jobs/ingest-reports.mjs, docker "ingest"):
GUARD_API_URL=http://127.0.0.1:8080

# ── LLM for the conversation. Blank = fixed safe lines + humanize fillers. ──
# With a key set, "sohbet modu": the RULES still decide the move + when to    ──
# hang up + the safety net; the LLM writes the actual sentence so it feels    ──
# like a real conversation (reacts to the caller, varies, stalls naturally).  ──
# Any one key below is enough — LLM_PROVIDER only forces a choice.
# LLM_PROVIDER = gemini | openai | anthropic | deepseek     (blank = auto)
LLM_PROVIDER=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
# LLM_MODEL=            # override the per-provider default
#                        gemini -> gemini-2.5-flash-lite  (no "thinking" latency)

# ── Public IP of this VM (for SIP / RTP). Blank = auto-detect. ──
PUBLIC_IP=
